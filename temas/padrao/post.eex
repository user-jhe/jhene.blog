<!-- post.eex: um post individual.
     Variáveis: @post (%Bloguin.Post{}) -->
<article class="post">
  <header>
    <a class="voltar" href="/">-&gt; todos os posts</a>
    <h1><%= Bloguin.Tema.esc(@post.titulo) %></h1>
    <div class="meta">
      <time datetime="<%= Date.to_iso8601(@post.data) %>">
        <%= Date.to_iso8601(@post.data) %>
      </time>
    </div>
    <%= if @post.tags != [] do %>
      <div class="tags">
        <%= for tag <- @post.tags do %>
          <a class="tag" href="/tags/<%= tag %>/"><%= tag %></a>
        <% end %>
      </div>
    <% end %>
  </header>

  <div class="prose">
    <%= @post.corpo %>
  </div>
</article>
