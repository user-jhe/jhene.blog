<!-- tag.eex: listagem dos posts de uma tag.
     Variáveis: @tag (string) e @posts (lista de %Bloguin.Post{}) -->
<h1 class="titulo-secao">#<%= Bloguin.Tema.esc(@tag) %></h1>

<ul class="lista-posts">
  <%= for post <- @posts do %>
    <li>
      <time datetime="<%= Date.to_iso8601(post.data) %>">
        <%= Calendar.strftime(post.data, "%d/%m/%Y") %>
      </time>
      <a href="<%= Bloguin.Post.caminho(post) %>"><%= Bloguin.Tema.esc(post.titulo) %></a>
    </li>
  <% end %>
</ul>

<p><a href="/">← todos os posts</a></p>
