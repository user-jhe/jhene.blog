<!-- inicio.eex: a listagem de posts da página inicial.
     Variáveis: @posts (lista de %Bloguin.Post{}, do mais novo pro mais velho) -->
<header class="cabecalho-lista">
  <p class="caminho">/posts</p>
  <h1>blog</h1>
  <p class="descricao"><%= Bloguin.Tema.esc(@site.descricao) %></p>
</header>

<ul class="lista-posts">
  <%= for post <- @posts do %>
    <li>
      <time datetime="<%= Date.to_iso8601(post.data) %>">
        <%= Date.to_iso8601(post.data) %>
      </time>
      <h2>
        <a href="<%= Bloguin.Post.caminho(post) %>"><%= Bloguin.Tema.esc(post.titulo) %></a>
      </h2>
      <%= if post.descricao != "" do %>
        <p class="descricao"><%= Bloguin.Tema.esc(post.descricao) %></p>
      <% end %>
      <%= if post.tags != [] do %>
        <div class="tags">
          <%= for tag <- post.tags do %>
            <a class="tag" href="/tags/<%= tag %>/"><%= tag %></a>
          <% end %>
        </div>
      <% end %>
    </li>
  <% end %>
</ul>
