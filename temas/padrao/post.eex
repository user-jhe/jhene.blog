<!-- post.eex: um post individual.
     Variáveis: @post (%Bloguin.Post{}) -->
<article class="post">
  <header>
    <h1><%= Bloguin.Tema.esc(@post.titulo) %></h1>
    <p class="meta">
      <time datetime="<%= Date.to_iso8601(@post.data) %>">
        <%= Calendar.strftime(@post.data, "%d/%m/%Y") %>
      </time>
      <%= for tag <- @post.tags do %>
        <a class="tag" href="/tags/<%= tag %>/">#<%= tag %></a>
      <% end %>
    </p>
  </header>

  <%= @post.corpo %>
</article>
